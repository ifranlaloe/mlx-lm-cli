#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -L "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

exec_target() {
  local target="$1"
  shift
  if [[ ! -x "$target" ]]; then
    echo "Missing or not executable: $target" >&2
    exit 1
  fi
  exec "$target" "$@"
}

SCRIPTS_DIR="$(resolve_script_dir)"

usage() {
  cat <<'EOF'
MLX launcher:
  cli/scripts/mlxlm server [server args...]
  cli/scripts/mlxlm codex [launcher args...] [-- <codex args...>]
  cli/scripts/mlxlm claude [launcher args...] [-- <claude args...>]
  cli/scripts/mlxlm copilot [launcher args...] [-- <copilot args...>]
  cli/scripts/mlxlm launch <codex|claude|copilot> [launcher args...] [-- <app args...>]

Examples:
  cli/scripts/mlxlm server --model mlx-community/Qwen3.6-35B-A3B-4bit
  cli/scripts/mlxlm codex --model mlx-community/Qwen3.6-35B-A3B-4bit
  cli/scripts/mlxlm launch copilot --model mlx-community/Qwen3.6-35B-A3B-4bit
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

case "${1:-}" in
  server)
    shift
    exec_target "$SCRIPTS_DIR/server" "$@"
    ;;
  codex)
    shift
    exec_target "$SCRIPTS_DIR/launchers/codex" "$@"
    ;;
  claude)
    shift
    exec_target "$SCRIPTS_DIR/launchers/claude" "$@"
    ;;
  copilot)
    shift
    exec_target "$SCRIPTS_DIR/launchers/copilot" "$@"
    ;;
  launch)
    shift
    case "${1:-}" in
      codex | claude | copilot)
        target="$1"
        shift
        exec_target "$SCRIPTS_DIR/launchers/$target" "$@"
        ;;
      *)
        echo "Unsupported launch target: ${1:-<none>}" >&2
        echo "Supported targets: codex, claude, copilot" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Unsupported command: ${1:-<none>}" >&2
    usage >&2
    exit 1
    ;;
esac
