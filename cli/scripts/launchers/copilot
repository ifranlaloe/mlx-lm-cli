#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$SCRIPTS_DIR/lib.sh"

COPILOT_CMD="${COPILOT_CMD:-copilot}"

usage() {
  cat <<'EOF'
Launch GitHub Copilot CLI in BYOK mode against an already-running MLX server:
  cli/scripts/launchers/copilot [--model MODEL] [--host HOST] [--port PORT] [--wait-seconds N] [-- <copilot args...>]

Examples:
  cli/scripts/launchers/copilot --model mlx-community/Qwen3.6-35B-A3B-4bit
  cli/scripts/launchers/copilot --model mlx-community/Qwen3.6-35B-A3B-4bit -- --help

Notes:
  - Requires cli/scripts/server (or mlxlm server) to be running first.
  - Valid launcher flags must be provided before `--`.
  - Arguments after `--` are forwarded to copilot.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

mlx_parse_launcher_args "$@"
MODEL="$MLX_MODEL"
HOST="$MLX_HOST"
PORT="$MLX_PORT"
WAIT_SECONDS="$MLX_WAIT_SECONDS"
SERVER_ARGS=("${MLX_SERVER_ARGS[@]+"${MLX_SERVER_ARGS[@]}"}")
APP_ARGS=("${MLX_APP_ARGS[@]+"${MLX_APP_ARGS[@]}"}")

mlx_require_command "$COPILOT_CMD"
mlx_require_command curl

if [[ ${#SERVER_ARGS[@]} -gt 0 ]]; then
  mlx_die "Unknown launcher arg(s): ${SERVER_ARGS[*]}. Use -- to pass args to copilot."
fi

if ! mlx_wait_for_server "$HOST" "$PORT" "$WAIT_SECONDS"; then
  mlx_die "MLX server is not reachable at $(mlx_server_base_url "$HOST" "$PORT")/models. Start it first with: mlxlm server --model \"$MODEL\" --host \"$HOST\" --port \"$PORT\""
fi

BASE_URL="$(mlx_server_base_url "$HOST" "$PORT")"
export MLX_BASE_URL="$BASE_URL"
export MLX_MODEL="$MODEL"
export COPILOT_PROVIDER_BASE_URL="$BASE_URL"
export COPILOT_PROVIDER_TYPE="${COPILOT_PROVIDER_TYPE:-openai}"
if [[ -z "${COPILOT_PROVIDER_BEARER_TOKEN:-}" && -z "${COPILOT_PROVIDER_API_KEY:-}" ]]; then
  export COPILOT_PROVIDER_API_KEY="local"
fi
export COPILOT_MODEL="${COPILOT_MODEL:-$MODEL}"

echo "Launching Copilot CLI (provider: $COPILOT_PROVIDER_BASE_URL, model: $COPILOT_MODEL)"
exec "$COPILOT_CMD" ${APP_ARGS[@]+"${APP_ARGS[@]}"}
