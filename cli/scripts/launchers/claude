#!/usr/bin/env bash
set -euo pipefail

SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$SCRIPTS_DIR/lib.sh"

CLAUDE_CMD="${CLAUDE_CMD:-claude}"

usage() {
  cat <<'EOF'
Launch Claude CLI with an already-running MLX server:
  cli/scripts/launchers/claude [--model MODEL] [--host HOST] [--port PORT] [--wait-seconds N] [-- <claude args...>]

Examples:
  cli/scripts/launchers/claude --model mlx-community/Qwen3.6-35B-A3B-4bit
  cli/scripts/launchers/claude --model mlx-community/Qwen3.6-35B-A3B-4bit -- --help

Notes:
  - Requires cli/scripts/server (or mlxlm server) to be running first.
  - Valid launcher flags must be provided before `--`.
  - Arguments after `--` are forwarded to claude.
  - This launcher exports OPENAI_* environment variables and expects your Claude setup to use them.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

mlx_parse_launcher_args "$@"
MODEL="$MLX_MODEL"
HOST="$MLX_HOST"
PORT="$MLX_PORT"
WAIT_SECONDS="$MLX_WAIT_SECONDS"
SERVER_ARGS=("${MLX_SERVER_ARGS[@]+"${MLX_SERVER_ARGS[@]}"}")
APP_ARGS=("${MLX_APP_ARGS[@]+"${MLX_APP_ARGS[@]}"}")

mlx_require_command "$CLAUDE_CMD"
mlx_require_command curl

if [[ ${#SERVER_ARGS[@]} -gt 0 ]]; then
  mlx_die "Unknown launcher arg(s): ${SERVER_ARGS[*]}. Use -- to pass args to claude."
fi

if ! mlx_wait_for_server "$HOST" "$PORT" "$WAIT_SECONDS"; then
  mlx_die "MLX server is not reachable at $(mlx_server_base_url "$HOST" "$PORT")/models. Start it first with: mlxlm server --model \"$MODEL\" --host \"$HOST\" --port \"$PORT\""
fi

BASE_URL="$(mlx_server_base_url "$HOST" "$PORT")"
export OPENAI_BASE_URL="$BASE_URL"
export OPENAI_API_BASE="$BASE_URL"
export OPENAI_API_KEY="${OPENAI_API_KEY:-local}"
export OPENAI_MODEL="${OPENAI_MODEL:-$MODEL}"
export MLX_BASE_URL="$BASE_URL"
export MLX_MODEL="$MODEL"

echo "Launching Claude CLI (endpoint: $OPENAI_BASE_URL, model: $OPENAI_MODEL)"
exec "$CLAUDE_CMD" ${APP_ARGS[@]+"${APP_ARGS[@]}"}
